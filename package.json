{
  "name": "tab-thinking-indicator",
  "version": "0.2.0",
  "private": true,
  "description": "A Sine mod that displays AI task progress in browser tabs.",
  "homepage": "https://github.com/Robot-Inventor/tab-thinking-indicator#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/tab-thinking-indicator/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/tab-thinking-indicator.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown && cp src/mod.css dist/mod.css",
    "lint": "tsc --noEmit && knip && oxlint src scripts",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "ci:version": "changeset version && bun run build && bun scripts/sync-version.ts && oxfmt --write theme.json && git add .",
    "ci:publish": "changeset publish"
  },
  "dependencies": {
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
