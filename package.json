  },
  "devDependencies": {
    "@robot-inventor/oxlint-config": "^0.5.2",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
